          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "errors": {}
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "RFC7807 problem response",
        "content": {
          "application/problem+json": {
            "schema": {
