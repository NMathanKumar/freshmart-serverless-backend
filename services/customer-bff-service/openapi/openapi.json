      "get": {
        "tags": [
          "Customer BFF"
        ],
        "summary": "Customer home aggregation",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Home"
          },
          "4XX": {
