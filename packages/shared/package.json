{
  "name": "@freshmart/shared",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/frontend.js",
  "types": "./dist/esm/frontend.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/frontend.d.ts",
      "import": "./dist/esm/frontend.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/frontend.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node copy-js-artifacts.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-eventbridge": "^3.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-sns": "^3.0.0",
    "@aws-sdk/client-sqs": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.0.0",
    "helmet": "^7.0.0",
    "serverless-http": "^3.2.0",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "zod": "^3.25.76"
  }
}
