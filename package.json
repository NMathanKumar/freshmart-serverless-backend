{
  "name": "freshmart-backend",
  "version": "2.0.0",
  "private": true,
  "description": "FreshMart production-grade quick commerce platform on AWS Serverless",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "scaffold:platform": "node scripts/generate-freshmart-platform.mjs",
    "scaffold:hardening-services": "node scripts/scaffold-hardening-services.mjs",
    "openapi:build": "node scripts/build-openapi.mjs",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "node --test --import tsx tests/integration/**/*.test.ts",
    "test:contracts": "node --test --import tsx tests/contracts/**/*.test.ts",
    "test:smoke:live": "node scripts/smoke-live.js",
    "test:load": "npx artillery run tests/load/artillery.yml",
    "test:load:staging": "npx artillery run tests/load/artillery-staging.yml",
    "test:load:report": "npx artillery run --output tests/load/report.json tests/load/artillery.yml && npx artillery report tests/load/report.json",
    "coverage": "c8 --reporter=text --reporter=lcov npm test && c8 --reporter=text --reporter=lcov node --test --import tsx tests/integration/**/*.test.ts && c8 --reporter=text --reporter=lcov node --test --import tsx tests/contracts/**/*.test.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "frontend:build": "npm run build --workspaces --if-present",
    "frontend:typecheck": "npm run typecheck --workspaces --if-present",
    "frontend:lint": "eslint .",
    "frontend:sdk": "node scripts/generate-frontend-sdk.mjs",
    "package": "node scripts/package.js all",
    "package:auth": "node scripts/package.js auth",
    "package:product": "node scripts/package.js product",
    "package:menu": "node scripts/package.js menu",
    "package:inventory": "node scripts/package.js inventory",
    "package:cart": "node scripts/package.js cart",
    "package:order": "node scripts/package.js order",
    "package:payment": "node scripts/package.js payment",
    "package:admin": "node scripts/package.js admin",
    "package:user": "node scripts/package.js user",
    "package:notification": "node scripts/package.js notification",
    "package:analytics": "node scripts/package.js analytics",
    "verify:production": "node scripts/verify-production.js",
    "verify:deployment": "node scripts/verify-deployment.js",
    "deploy:customer": "npm run build --workspace=@freshmart/customer-web && node scripts/deploy-web.js customer",
    "deploy:admin": "npm run build --workspace=@freshmart/admin-web && node scripts/deploy-web.js admin",
    "deploy:web": "npm run build --workspace=@freshmart/customer-web && npm run build --workspace=@freshmart/admin-web && node scripts/deploy-web.js all",
    "deploy:all": "npm run build && cd terraform/environments/dev && terraform apply -auto-approve -var=\"internal_service_token=dev-internal-service-token-secret-123\" && cd ../../.. && npm run deploy:web && npm run test:smoke:deployment",
    "rollback:web": "node scripts/rollback-web.js all",
    "rollback:lambda": "echo 'Lambda rollback: please specify function name and version'",
    "test:smoke:deployment": "npx tsx scripts/smoke-deployment.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.842.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.842.0",
    "@aws-sdk/client-dynamodb": "^3.842.0",
    "@aws-sdk/client-eventbridge": "^3.842.0",
    "@aws-sdk/client-s3": "^3.842.0",
    "@aws-sdk/client-sns": "^3.842.0",
    "@aws-sdk/client-sqs": "^3.842.0",
    "@aws-sdk/lib-dynamodb": "^3.842.0",
    "aws-jwt-verify": "^5.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.61.1",
    "@types/aws-lambda": "^8.10.149",
    "@types/node": "^24.0.15",
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "c8": "^10.1.3",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0"
  }
}
